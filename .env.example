# Local defaults work without this file. Export variables in your shell or service.
# The app does not automatically read .env files.
DEBLOCK_ENV=development
DEBLOCK_ORIGIN=http://127.0.0.1:8003

# Required when DEBLOCK_ENV=production (replace every example).
# Generate a random secret: python -c 'import secrets; print(secrets.token_urlsafe(64))'
# DJANGO_SECRET_KEY=
# DEBLOCK_ORIGIN=https://your-domain.example
# DATABASE_URL=postgresql://deblock:password@database.example:5432/deblock
# DEBLOCK_DB_SSLMODE=verify-full
# PGSSLROOTCERT=/run/secrets/postgres-ca.pem
# REDIS_URL=rediss://user:password@cache.example:6379/0
# EMAIL_HOST=smtp.example
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=deblock <hello@your-domain.example>

# Set only behind a trusted reverse proxy which strips incoming forwarded headers
# and sets them itself. Keep the app port inaccessible to the public.
# DEBLOCK_TRUST_PROXY_HTTPS=1
# DEBLOCK_TRUSTED_PROXY_COUNT=1
